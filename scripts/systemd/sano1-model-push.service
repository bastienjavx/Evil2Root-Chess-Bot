[Unit]
Description=San-o1 - Push latest model checkpoint to GitHub Release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=evil2root
Group=evil2root
WorkingDirectory=/home/evil2root/Bureau/San-o1
ExecStart=/home/evil2root/Bureau/San-o1/scripts/push_latest_model.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sano1-model-push
