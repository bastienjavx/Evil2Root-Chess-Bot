[Unit]
Description=San-o1 — Collecte parties Lichess -> replay buffer (stream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=evil2root
Group=evil2root
WorkingDirectory=/home/evil2root/Bureau/San-o1
ExecStart=/home/evil2root/Bureau/San-o1/scripts/run_stream.sh
# Collecte permanente : on relance toujours (déconnexions, fin de flux).
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sano1-stream

[Install]
WantedBy=multi-user.target
